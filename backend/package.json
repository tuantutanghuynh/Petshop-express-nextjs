{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "tsx ./bin/www.ts",
    "dev": "nodemon --watch . --ext ts --exec tsx ./bin/www.ts",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test vitest run",
    "db:push": "DATABASE_URL=$(grep '^DIRECT_URL' .env | cut -d '\"' -f2) prisma db push",
    "db:diff": "DATABASE_URL=$(grep '^DIRECT_URL' .env | cut -d '\"' -f2) prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --script",
    "test:coverage": "NODE_ENV=test vitest run --coverage",
    "test:db": "NODE_ENV=test vitest run --config vitest.db.config.ts",
    "test:db:coverage": "NODE_ENV=test vitest run --config vitest.db.config.ts --coverage",
    "test:all": "npm test && npm run test:db",
    "db:seed:petshop": "tsx scripts/seedPetshop.ts",
    "seed:category-tree": "tsx scripts/seedCategoryTree.ts",
    "db:migrate-demo-categories": "tsx scripts/migrateDemoCategories.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "http-errors": "^2.0.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "multer": "^2.3.0",
    "pg": "^8.23.0",
    "streamifier": "^0.1.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.3",
    "fast-check": "^4.10.2",
    "nodemon": "^3.1.14",
    "prisma": "^7.9.1",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
