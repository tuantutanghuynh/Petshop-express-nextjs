generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  passwordHash        String
  fullName            String?
  role                String               @default("customer")
  createdAt           DateTime             @default(now())
  blogPosts           BlogPost[]
  carts               Cart[]
  orders              Order[]
  passwordResetTokens PasswordResetToken[]
  quoteRequests       QuoteRequest[]
  inventoryMovements  InventoryMovement[]
}

model Category {
  id           String              @id @default(uuid())
  parentId     String?
  name         String
  slug         String              @unique
  description  String?
  createdAt    DateTime            @default(now())
  attributes   CategoryAttribute[]
  products     Product[]
  blogPosts    BlogPost[]
  galleryItems GalleryItem[]
}

model CategoryAttribute {
  id              String   @id @default(uuid())
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id])
  attributeKey    String
  attributeLabel  String
  attributeType   String
  isRequired      Boolean  @default(false)
  isFilterable    Boolean  @default(true)
  options         Json?
  validationRules Json?

  @@index([categoryId])
}

model Product {
  id          String           @id @default(uuid())
  categoryId  String
  category    Category         @relation(fields: [categoryId], references: [id])
  name        String
  slug        String           @unique
  description String?
  brand       String?
  status      String           @default("draft")
  attributes  Json             @default("{}")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  variants    ProductVariant[]
  images      ProductImage[]

  @@index([categoryId])
  // Storefront list: WHERE status = 'active' ORDER BY createdAt DESC, id DESC (id = tie-breaker).
  @@index([status, createdAt, id])
}

model ProductVariant {
  id                 String              @id @default(uuid())
  productId          String
  product            Product             @relation(fields: [productId], references: [id])
  sku                String              @unique
  price              Int
  compareAtPrice     Int?
  stockQuantity      Int                 @default(0)
  reservedQuantity   Int                 @default(0)
  variantAttributes  Json                @default("{}")
  variantKey         String
  imageUrl           String?
  cartItems          CartItem[]
  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]

  @@unique([productId, variantKey])
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])
  url       String
  altText   String?
  position  Int     @default(0)

  @@index([productId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([tokenHash])
  @@index([userId])
}

model BlogPost {
  id             String    @id @default(uuid())
  title          String
  slug           String    @unique
  excerpt        String?
  content        String
  coverImageUrl  String?
  authorId       String
  author         User      @relation(fields: [authorId], references: [id])
  categoryId     String?
  category       Category? @relation(fields: [categoryId], references: [id])
  status         String    @default("draft")
  seoTitle       String?
  seoDescription String?
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([authorId])
  @@index([categoryId])
  // Public blog list: WHERE status = 'published' AND publishedAt <= now ORDER BY publishedAt DESC, id DESC.
  @@index([status, publishedAt, id])
}

model GalleryItem {
  id         String    @id @default(uuid())
  title      String?
  imageUrl   String
  altText    String
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  position   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([categoryId])
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Cart {
  id        String     @id @default(uuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  brandSlug String
  items     CartItem[]
  updatedAt DateTime   @updatedAt
  createdAt DateTime   @default(now())

  @@unique([userId, brandSlug])
}

model CartItem {
  id        String         @id @default(uuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime       @default(now())

  @@unique([cartId, variantId])
  @@index([variantId])
}

model Order {
  id     String @id @default(uuid())
  code   String @unique
  userId String
  user   User   @relation(fields: [userId], references: [id])

  brandSlug     String
  orderStatus   String @default("PENDING_PAYMENT")
  paymentMethod String
  paymentStatus String @default("PENDING")

  subtotal    Int
  shippingFee Int @default(0)
  grandTotal  Int

  shippingAddress Json
  note            String?

  items              OrderItem[]
  inventoryMovements InventoryMovement[]

  expiresAt DateTime?
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Client-chosen key for one checkout attempt (Idempotency-Key header). A retried or double
  // submitted checkout with the same key returns this order instead of failing on the now empty
  // cart. Unique per user only; NULL for orders placed without a key (PostgreSQL allows many NULLs).
  idempotencyKey String?

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([brandSlug, orderStatus])
}

model OrderItem {
  id        String          @id @default(uuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  productName String
  sku         String
  unitPrice   Int
  quantity    Int
  lineTotal   Int

  @@index([orderId])
  @@index([variantId])
}

// Yêu cầu tư vấn mua hàng. Khách chọn sản phẩm rồi để lại thông tin, nhân viên gọi lại và
// chốt đơn thủ công qua điện thoại/chat — không có thanh toán online, không trừ kho, không
// giữ hàng. Đây là luồng bán hàng thật đang chạy; phần giỏ hàng + thanh toán tự động nằm ở
// nhánh feature/ecommerce-cart và chưa đưa vào production.
//
// `items` để dạng JSON thay vì bảng con vì nó là bản chụp tại thời điểm khách hỏi, phục vụ
// cho một cuộc gọi — không bao giờ cần truy vấn ngược "sản phẩm X đã được ai hỏi".
// `email` cho phép rỗng: khách Việt thường chỉ để số điện thoại, bắt buộc email sẽ làm mất
// khách thật. Số điện thoại mới là kênh liên lạc chính nên nó bắt buộc.
model QuoteRequest {
  id        String @id @default(uuid())
  brandSlug String

  // Gắn vào tài khoản KHI khách tình cờ đang đăng nhập, và chỉ khi đó. Luồng này cố ý không
  // bắt đăng nhập — bắt buộc tài khoản là dựng một bức tường ngay trước lúc khách sắp để lại
  // số điện thoại, mà tài khoản cũng không cung cấp thêm gì so với họ tên/SĐT/địa chỉ đã thu
  // trong form. Có userId thì khách xem lại được đơn trong trang cá nhân; không có thì nhân
  // viên vẫn gọi bình thường.
  userId       String?
  user         User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName String
  phone        String
  email        String?
  address      String
  note         String?
  items        Json
  status       String  @default("NEW")

  // Số tiền chốt thật và thời điểm chốt, nhân viên nhập khi bấm "Đã chốt".
  //
  // Phải là trường riêng chứ không tính lại từ `items`: giá trong `items` là giá khách xem
  // trên web, còn nhân viên gọi điện thì mặc cả, cộng phí ship, giảm cho khách quen — con số
  // cuối cùng gần như luôn khác. Thống kê doanh thu dựng trên `items` sẽ sai ngay từ ngày đầu.
  finalAmount Int?
  closedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandSlug, status, createdAt])
  // Phục vụ thống kê doanh thu theo khoảng thời gian.
  @@index([brandSlug, closedAt])
  // Phục vụ màn "đơn của tôi" trong trang cá nhân.
  @@index([userId, createdAt])
}

// Bảng cấu hình lưu trữ các thiết lập động cho giao diện trang web (CMS)
// key: homepage_hero_image, homepage_artist_image, v.v.
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// Lưu token để reset password. Token này được hash trước khi lưu (để không lưu cleartext).
// Flow: admin/khách gửi email → backend generate token + send link (log) → khách bấm link
// → khách POST token + password mới → backend verify token + update password
model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique // Hash của token (không lưu cleartext)
  expiresAt DateTime // 1 hour từ lúc tạo
  createdAt DateTime @default(now())

  @@index([userId])
}

// Ledger of every change to a variant's PHYSICAL stock (ADR-007). stockQuantity is changed only by
// adding a delta, and each change writes one row here in the same transaction, so
// sum(delta) per variant always equals its stockQuantity and every unit can be traced.
// Holds for bank transfers (reservedQuantity) are not stock movements and are not recorded.
//
// reason: OPENING (creation) · PURCHASE · DAMAGED · RETURN · OTHER (admin deltas) · STOCKTAKE
// (counted − system) · SALE (COD checkout / confirmed transfer) · CANCEL_RESTOCK (cancelled after
// the stock left). Rows survive deletion of the variant / user / order (SET NULL) with the SKU
// snapshotted, because an audit trail that disappears with the product is not an audit trail.
model InventoryMovement {
  id            String          @id @default(uuid())
  // Insertion order. Rows are written while the variant row is locked, so seq is the true order
  // of stock changes; createdAt is not (now() is the transaction START, at millisecond precision).
  seq           Int             @unique @default(autoincrement())
  variantId     String?
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  sku           String
  delta         Int
  quantityAfter Int
  reason        String
  note          String?
  userId        String?
  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderId       String?
  order         Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now())

  @@index([variantId, seq])
  @@index([orderId])
  @@index([userId])
}
