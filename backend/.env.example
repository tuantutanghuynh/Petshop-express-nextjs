PORT=4000
# development (default when unset) | production. Tests set "test" themselves.
NODE_ENV=development
DATABASE_URL="postgresql://miniecom:miniecom@localhost:5434/miniecom?schema=public"
JWT_ACCESS_SECRET=example_access_secret
# Max database connections per backend process (default 10).
DB_POOL_MAX=10
# Comma-separated browser origins allowed to call the API with credentials (CORS).
# Production example: https://tupetshop.vercel.app
FRONTEND_URLS=http://localhost:3000
# Optional regex for Vercel preview URLs (not airtight on vercel.app — prefer exact URLs above), e.g.
# ^https://tupetshop-[a-z0-9-]+-<team-slug>\.vercel\.app$   (leave unset to block previews)
FRONTEND_ORIGIN_PATTERN=
# Shared secret the Next.js SERVER sends as X-Internal-Secret so server-side rendering is not
# rate limited (all SSR traffic comes from one IP). Long random string; never expose to the browser.
INTERNAL_API_SECRET=

# Storefront origin used in links sent by email (password reset). Required in production.
PUBLIC_SITE_URL=http://localhost:3000
# Outgoing email (SMTP). Required in production; without SMTP_HOST, development prints emails to
# the console. Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<gmail>, SMTP_PASS=<app password>.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Siêu thị của chó mèo <shop@example.com>"
