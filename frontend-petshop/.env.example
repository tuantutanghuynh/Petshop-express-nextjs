# Copy to .env.local and fill in. Never commit real values.

# Express API base URL, including /api/v1. Used by server and browser code.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Origin of the Express server, for legacy /uploads/... image paths (new images are full Cloudinary URLs).
NEXT_PUBLIC_BACKEND_ORIGIN=http://localhost:4000

# Same value as INTERNAL_API_SECRET in backend/.env. Sent only by the Next.js SERVER as
# X-Internal-Secret so server-side rendering is not rate limited. NO NEXT_PUBLIC_ prefix:
# it must never reach the browser.
INTERNAL_API_SECRET=

# Public base URL of this site, no trailing slash. Every canonical, Open Graph URL, sitemap and
# robots entry is built from it. REQUIRED when APP_ENV=production (the build fails without it).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Root category slug of this storefront; also sent as X-Brand-Slug for cart / orders / quotes.
NEXT_PUBLIC_BRAND_SLUG=petshop

# "production" only on the real site. Anything else adds X-Robots-Tag: noindex to every page.
APP_ENV=development
